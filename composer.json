{
    "name": "valourite/dynamic-models",
    "description": "A laravel filament plugin for creating dynamic models.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dayne Myburgh",
            "email": "dayne@valourite.co.za"
        }
    ],
    "autoload": {
        "psr-4": {
            "Valourite\\DynamicModels\\": "src/",
            "Valourite\\DynamicModels\\Database\\Factories\\": "database/factories/"
        }
    },
    "require": {
        "php": "^8.2",
       "laravel/framework": "^12.0",
       "filament/filament": "^4.0",
       "spatie/laravel-package-tools": "^1.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Valourite\\DynamicModels\\DynamicModelsProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "v2.x-dev"
        }
    },
    "minimum-stability": "beta"
}
